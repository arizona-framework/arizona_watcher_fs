{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% Pinned to main until an arizona release ships the arizona_watcher behaviour.
    {arizona, {git, "https://github.com/arizona-framework/arizona.git", {branch, "main"}}},
    {fs, "11.4.1"}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        arizona,
        fs
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]},
    incremental
]}.

{alias, [
    {test, [
        {ct, "--cover"}
    ]},
    {check_cover, [
        {cover, "--min_coverage 80 --verbose"}
    ]},
    {doc, [
        ex_doc
    ]}
]}.

{profiles, [
    {default, [
        {xref_checks, [
            exports_not_used,
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]},
    {test, [
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {erl_opts, [
            debug_info,
            nowarn_missing_spec,
            warnings_as_errors
        ]},
        {dialyzer, [
            {plt_apps, all_deps},
            {plt_extra_apps, [
                arizona,
                fs,
                common_test
            ]},
            {warnings, [
                unknown,
                unmatched_returns
            ]},
            incremental
        ]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"},
    {rebar3_hank, "2.0.1"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{hank, [
    {ignore, [
        {"test/arizona_watcher_fs_SUITE.erl", [unnecessary_function_arguments]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "rebar.config",
        "src/*.app.src",
        "src/**/*.erl",
        "test/**/*.erl"
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, false},
    {source_url, "https://github.com/arizona-framework/arizona_watcher_fs"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
